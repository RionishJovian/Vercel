FROM node:22-alpine AS app
WORKDIR /app
COPY app/package.json app/package-lock.json ./
RUN npm ci --ignore-scripts
COPY app/ ./
RUN npm run build
COPY deploy/compat/console-5931ed0 /legacy-source
COPY scripts/legacy-console-assets.mjs /legacy-console-assets.mjs
RUN node /legacy-console-assets.mjs /legacy-source /legacy-console

FROM caddy:2.10-alpine
COPY web /srv
# The React app is the console, served at /app/ (old /v2/ URLs redirect there; see the Caddyfile).
COPY --from=app /app/dist /srv/app
COPY --from=app /legacy-console /srv/v2
COPY deploy/Caddyfile.go-staging /etc/caddy/Caddyfile
COPY deploy/security-headers.caddy /etc/caddy/security-headers.caddy
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=10 CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
