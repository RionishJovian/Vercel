# Copy to /etc/mm-monitor.env (mode 600). Both lines are optional.
# Create a free check at healthchecks.io for each, set its period (backup: 1 day, grace 3 hours; drill: 7 days,
# grace 1 day) and paste its ping URL here. The scripts ping the URL when they succeed and URL/fail when they fail,
# and healthchecks.io emails you if a ping does not arrive on time (a missed run is also an alert).
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_DRILL_URL=
