# A release operator must set this to the exact inspected host-to-web peer.
# Loopback default does not trust Docker neighbors. Never use private_ranges.
{
    servers {
        trusted_proxies static {$MM_EDGE_PROXY_IP:127.0.0.1}
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For
    }
}

import security-headers.caddy

:80 {
    import mm_security_headers
    # Pages and the console's index revalidate; fingerprinted assets do not need to.
    @nocache not path /assets/* /app/assets/* /v2/assets/*
    header @nocache Cache-Control "no-cache"
    encode gzip
    root * /srv

    # Clean public URLs. Old .html links and bookmarks redirect with their query string kept.
    @signinOld path /signin.html
    redir @signinOld /signin{?query} 301
    @pricingOld path /pricing.html
    redir @pricingOld /pricing{?query} 301
    rewrite /signin /signin.html
    rewrite /pricing /pricing.html

    # The console lives at /app/<page>. Older console URLs move there: /v2/ (and /v2/#/page bookmarks — the
    # browser keeps the #… across the redirect and the console turns it into /app/page), /v2/<file>, and /app.html.
    @v2root path /v2 /v2/ /v2/index.html
    redir @v2root /app/{?query} 301
    @v2rest {
        path_regexp v2rest ^/v2/(.+)$
        not path /v2/assets/*
    }
    redir @v2rest /app/{re.v2rest.1}{?query} 301
    @oldapp path /app.html
    redir @oldapp /app/home{?query} 302
    redir /app /app/ 301

    handle /api/* {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle /ready {
        reverse_proxy api:8080
    }
    # Old open tabs retain the exact previous release's chunks at their original URLs.
    handle /v2/assets/* {
        file_server
    }
    # Missing console files are 404 (never the page HTML).
    handle /app/assets/* {
        file_server
    }
    # Console pages: a real file when there is one, otherwise the app's index for every page path.
    handle /app/* {
        try_files {path} /app/index.html
        file_server
    }
    handle {
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
