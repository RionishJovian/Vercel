# A release operator must set this to the exact inspected host-to-web peer.
# Loopback default does not trust Docker neighbors. Never use private_ranges.
{
    servers {
        trusted_proxies static {$MM_EDGE_PROXY_IP:127.0.0.1}
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For
    }
}

import security-headers.caddy

:80 {
    import mm_security_headers
    @html path / /*.html
    header @html Cache-Control "no-cache"
    encode gzip
    root * /srv
    # Old bookmarks to the retired console land on the React app at /v2/.
    @oldapp path /app.html
    redir @oldapp /v2/ 302
    # Serve the React app's index for the directory URL instead of the landing fallback.
    @v2root path /v2 /v2/
    rewrite @v2root /v2/index.html
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle /ready {
        reverse_proxy api:8080
    }
    handle {
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
