import security-headers.caddy

:80 {
    import mm_security_headers
    encode gzip
    root * /srv
    handle /api/* {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle /ready {
        reverse_proxy api:8080
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
