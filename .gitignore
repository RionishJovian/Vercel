# Secrets — never commit
config.yaml
.env
.env.*
*.key
*.pem
secrets/

# Binaries & build artifacts
bin/
tmp/
*.exe
*.test
*.out
*.prof
mm-*
/build/
/server
# deploy.sh's rollback binary (~22 MB) — a build artifact, never source.
/server.prev
/server.*

# Cross-agent handoff notes (written by other agents, untrusted content)
.peer-*.md

# Dependencies & node
node_modules/
.bun/
bun.lockb
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Logs
*.log
logs/

# Air hot-reload
.tmp*/

# Migration exports (regenerated by scripts/migration/run_phase1.sh)
scripts/migration/csv-out/
# PHASE 2 section extracted from init.sql on every apply_ported_schema.sh run —
# generated, so never tracked (the canonical source is database/init.sql).
scripts/migration/.ported.sql

# Generated production frontend build
vercel-public/
.vercel/
