# Mega Magic Project - Configuration
# Copy to config.yaml and customize

# Production fails closed unless RLS is enabled and the database/JWT/AES
# secrets below are replaced with strong, deployment-specific values.
environment: development

# Server
server:
  host: "0.0.0.0"
  port: 8080
  grpc_port: 9090
  read_timeout: 30s
  write_timeout: 30s
  shutdown_timeout: 10s

# Database (PostgreSQL)
database:
  host: "localhost"
  port: 5433
  user: "mega_admin"
  password: "CHANGE-ME"
  name: "mega_magic"
  sslmode: "disable"
  max_open_conns: 25
  max_idle_conns: 5
  conn_max_lifetime: 300s
  # RLS enforcement (keystone): when true, protected requests run on a tenant
  # connection bound to `authenticated` + app.current_business_id. Default false
  # (byte-identical to an owner pool). Enable only after a restricted DB role is
  # provisioned (see docs) and the conversion rollout is complete.
  rls_enforce: false

# Billing: plan-driven pass durations (minutes). A plan with no duration is NOT
# purchasable (fail closed). The Lead sets the real numbers here.
billing:
  # Enable only after the individual-pass migration and once-only 7-day rollout.
  individual_passes_enabled: false
  # Enable only after the one-time transition-trial migration and verified rollout.
  subscription_only: false
  existing_account_policy: require_payment
  receipt_dir: ./data/receipts
  quota_enforcement_interval: 60s   # periodic sweep emitting quota.pass.expired
  plans:
    sovereign:
      duration_minutes: 43200  # 30 days — Lead-set (30 × 24 × 60)

# AI / scanning service (gated off by default).
ai:
  enabled: false
  mode: auto            # "auto" | "fallback" | "ollama" | "openrouter"
                        #   auto       = ollama, fallback on unreachable (never calls OpenRouter)
                        #   fallback   = deterministic rules only
                        #   ollama     = local Ollama
                        #   openrouter = OpenRouter free completion model
  ollama_url: http://127.0.0.1:11434
  cost_per_analysis: 1
  # OpenRouter (only used when mode: openrouter). API key is a SECRET — inject via
  # config/env; never commit. Default model was probed live (2026-09-26) and is the
  # only candidate returning parseable finding JSON with response_format=json_object.
  openrouter_url: https://openrouter.ai/api/v1
  openrouter_api_key: ""
  openrouter_model: openrouter/free
  # Magic Dude chat provider (independent of ai.mode for fleet scans).
  magic_dude_provider: openrouter # openrouter | gemini
  gemini_api_key: ""             # set AI_GEMINI_API_KEY or GEMINI_API_KEY securely
  gemini_model: gemini-3.8-flash  # availability/quota checked by setup script
  # Operator incident DM (Telegram). Off by default; ADDITIVE to webhooks. The
  # bot token is a SECRET — inject via config/env, never commit. Empty token or
  # chat id degrades to no-op (webhooks only).
  notify_telegram_enabled: false
  notify_telegram_bot_token: ""
  notify_telegram_chat_id: 0

# Redis Cache
redis:
  host: "localhost"
  port: 6379
  password: ""
  db: 0
  pool_size: 10
  min_idle_conns: 2
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s

# NATS Message Bus
nats:
  url: "nats://localhost:4222"
  jetstream: true
  max_reconnects: -1
  reconnect_wait: 2s
  ping_interval: 20s
  max_outstanding_pings: 3

# Magic Hub WireGuard - this is the hub interface itself. On the single-instance
# deployment it is wg0 (see also provisioner.applier.interface above; the two
# must agree or router enrollment silently fails with 503).
wireguard:
  interface: "wg0"
  listen_port: 13231
  peer_keepalive: 25s
  allowed_ips:
    - "10.255.0.1/32"
    - "192.168.0.0/16"
  management_vlan: 99
  management_subnet: "192.168.99.0/24"

# Telemetry
telemetry:
  hardware_interval: 60s       # Hardware snapshot every 60s
  heartbeat_interval: 25s      # WireGuard keep-alive every 25s
  retention_days: 30           # Telemetry retention
  max_batch_size: 100          # Batch insert size

# Quotas (Test Profile Alpha defaults)
quotas:
  small_wisp_device_limit: 10
  enterprise_isp_device_limit: 100
  global_admin_device_limit: 99999
  ai_tokens_monthly_small: 50000
  ai_tokens_monthly_enterprise: 2000000
  webfig_pass_duration: 3h

# Security
security:
  jwt_secret: "CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_32_BYTES"
  jwt_expiry: 24h
  refresh_expiry: 168h  # 7 days
  bcrypt_cost: 12
  aes_gcm_key: "CHANGE_ME_32_BYTE_KEY_FOR_ENCRYPTION"
  tls_cert_path: ""
  tls_key_path: ""

# Logging
logging:
  level: "debug"
  format: "json"
  output: "stdout"
  sampling: true

# Feature Flags
features:
  ai_scan_enabled: true
  voucher_system_enabled: true
  portal_consent_enabled: true
  topology_canvas_enabled: true
  magic_switch_enabled: true
  webfig_proxy_enabled: true

# Monitoring
monitoring:
  metrics_port: 9091
  health_check_interval: 30s
  sla_check_interval: 60s
  alert_webhook_url: ""

# Provisioner real apply path (SSH + RouterOS). DISABLED by default. When
# enabled, every action resolves the exact tenant/device target from encrypted
# device credentials; no deployment-wide fallback router exists.
provisioner:
  # REQUIRED when either posture_capture or applier is enabled. Every
  # database-resolved SSH target must fall inside one of these networks.
  # Use the WireGuard management subnet(s), never 0.0.0.0/0 or ::/0.
  allowed_target_cidrs:
    - "10.77.0.0/24"
  applier:
    enabled: false
    credential_key: ""       # base64/hex 32-byte key; inject via env/config
    # The fields below are retained only for the standalone disposable-lab
    # constructor. The server's fleet path ignores them and uses each device's
    # stored address, credential and required SHA256 host-key fingerprint.
    host: ""
    port: 22
    user: ""
    password: ""
    private_key_path: ""
    insecure_ignore_host_key: false  # leave false; true is for a disposable lab only and production refuses to start with it
    allow_empty_password: false      # true only for a disposable lab (admin/empty)
    timeout: 10s
    # MUST name an interface that exists on THIS host. On the single-instance
    # layout the Hub runs here too, so it is wg0 - not a separate wg-magichub.
    # A wrong name makes every enrollment attempt return 503 "Magic Hub
    # enrollment is not enabled", because no reachable target can be resolved.
    interface: "wg0"
    listen_port_rotate_to: 0         # required for rotate_listen_port
    reset_hold: 30s                  # disable-peer hold (> UDP timeout)
    ping_target: "10.77.0.1"         # required IP: WireGuard hub probed after every live change
    management_cidrs:                 # only these sources retain SSH/Winbox after hardening
      - "10.77.0.0/24"
    t_down: 180s
    # RFC 6238 TOTP gate for HIGH-RISK actions (rotate_listen_port/escalate).
    # Empty secret => high-risk approvals stay DENIED. Inject the secret via
    # config/env; never commit it.
    otp_secret: ""
    otp_digits: 6
    otp_step: 30s
    otp_skew: 1
 # Magic Media pilot: apply 20261001120000_magic_media_connector.sql and verify
 # its RLS/queue integration before enabling. No automatic installation.
media:
  connector_enabled: false

# Guest internet vouchers: apply the guest_voucher_grants migration and verify
# real-router quota/elapsed-expiry acceptance before enabling. Not business passes.
guest_wifi:
  enabled: false
  voucher_access_enabled: false
  bridge_scan_interval: 30s

vps:
  endpoint_host: ""
  # Magic Hub enrollment. These MUST be present here, not only as VPS_HUB_*
  # environment variables: the server loads config.yaml with viper and binds
  # env vars only for ai.* keys, so a missing hub key makes every
  # /vps/peers/{id}/quick-enroll call fail with 503 "not enabled".
  hub_lookup_enabled: false
  hub_enrollment_enabled: false
  hub_url: "https://hub.example.com/internal/provisioner"
  hub_key_id: "v1"
  hub_signing_key: ""
